set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)
set(MODERN_LLVM_VERSION 22.1.8)

find_program(CMAKE_C_COMPILER clang-cl REQUIRED)
set(CMAKE_CXX_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_C_COMPILER_TARGET i686-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET i686-pc-windows-msvc)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

execute_process(COMMAND "${CMAKE_C_COMPILER}" --version OUTPUT_VARIABLE MODERN_CLANG_VERSION_TEXT)
if(NOT MODERN_CLANG_VERSION_TEXT MATCHES "clang version ${MODERN_LLVM_VERSION}[^0-9]")
  message(FATAL_ERROR "The modern build needs LLVM ${MODERN_LLVM_VERSION}; ${CMAKE_C_COMPILER} reports:\n${MODERN_CLANG_VERSION_TEXT}")
endif()

set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
