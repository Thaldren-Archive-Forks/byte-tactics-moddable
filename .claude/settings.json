{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$BT_ROLE\" ] || uv run --no-project --quiet python -I \"$CLAUDE_PROJECT_DIR/tools/role_guard.py\""
          }
        ]
      }
    ]
  }
}
